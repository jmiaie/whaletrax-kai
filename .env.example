# WhaleTrax environment variables
# Copy to .env and edit as needed. None of these are required for read-only usage.

# ── API base URLs (change only if using a proxy or test environment) ──────────
# GAMMA_API_BASE=https://gamma-api.polymarket.com
# DATA_API_BASE=https://data-api.polymarket.com
# CLOB_API_BASE=https://clob.polymarket.com

# ── HTTP settings ─────────────────────────────────────────────────────────────
# REQUEST_TIMEOUT=30        # seconds
# MAX_RETRIES=3
# RETRY_BACKOFF=1.5         # seconds between retries

# ── Pagination ────────────────────────────────────────────────────────────────
# DEFAULT_PAGE_LIMIT=100
# MAX_PAGES=10

# ── Big-win thresholds ────────────────────────────────────────────────────────
# BIG_WIN_MIN_PROFIT_USDC=500       # minimum realised profit per trade
# BIG_WIN_MIN_ROI_PCT=50            # minimum ROI % per trade
# BIG_WIN_MIN_TRADE_SIZE_USDC=100   # minimum cost basis

# ── Scan settings ─────────────────────────────────────────────────────────────
# LEADERBOARD_TOP_N=50
# WALLET_SCAN_MAX_TRADES=500
# MARKET_TOP_HOLDERS_N=20
# DISPLAY_TOP_N=20

# ── WalletHound settings ─────────────────────────────────────────────────────
# WALLETHOUND_PORT=5000                  # web dashboard port
# FLASK_SECRET_KEY=change-me-in-prod     # Flask session secret
# FLASK_DEBUG=0                          # set to 1 for development
